{
  "manifest_version": 3,
  "name": "Mijn Startpagina",
  "version": "5.2.0",
  "description": "Een rustige, persoonlijke startpagina met je eigen apps, klok en achtergrond.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "unlimitedStorage", "favicon"],
  "host_permissions": [
    "https://cdn.jsdelivr.net/*",
    "https://www.google.com/*",
    "https://*.gstatic.com/*",
    "https://icons.duckduckgo.com/*",
    "https://icon.horse/*",
    "https://images.unsplash.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
